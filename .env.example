# Copy to .env and fill in real values before `docker compose up -d --build`.
# Never commit the real .env.

# Domains Caddy will request Let's Encrypt certs for — DNS A/AAAA records
# for each must already point at this server before starting Caddy.
WEB_DOMAIN=book.dazyclub.com
ADMIN_DOMAIN=admin.dazyclub.com
KIOSK_DOMAIN=pos.dazyclub.com
API_DOMAIN=api.dazyclub.com

# Runtime mode. Set to "production" for a live deploy: the API then refuses to boot
# with default JWT secret / admin creds or the noop payment provider. (Render sets
# this via render.yaml; leave empty for local dev and keyless trials.)
DAZY_ENV=

# Auth — MUST be changed from defaults before going live.
JWT_SECRET=replace-with-a-random-32-plus-character-string
ADMIN_USERNAME=replace-with-a-real-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional, preferred: bcrypt hash of the admin password (replaces ADMIN_PASSWORD when set).
#   python -c "import bcrypt;print(bcrypt.hashpw(b'your-password',bcrypt.gensalt()).decode())"
# NOTE: in this file (read by docker compose) escape every "$" in the hash as "$$".
ADMIN_PASSWORD_HASH=

# Payment — set to razorpay + real keys for live checkout. With the default
# (noop) the booking flow still works, using dev "Simulate payment" buttons.
# Register the webhook in the Razorpay dashboard as
#   https://<API_DOMAIN>/api/v1/payments/razorpay/webhook
# (event: payment.captured) and paste its secret below.
DAZY_PAYMENT_PROVIDER=noop
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notifications — console (default) logs sends to `docker compose logs api`;
# set to email + SMTP creds to actually deliver booking confirmations.
DAZY_NOTIFY_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Render (production API) is configured in render.yaml. Every variable below that the
# API reads must also be listed there — keep both files in sync.
#
# Links / CORS. Compose sets these itself from the *_DOMAIN values above; set them
# explicitly on Render and for local overrides.
# DAZY_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# DAZY_WEB_BASE_URL=http://localhost:5173
#
# Database. Defaults to SQLite at DAZY_DB_PATH. Set DAZY_DB_URL to Postgres (Neon pooled
# URL ending in ?sslmode=require) with zero code changes; it overrides DAZY_DB_PATH.
# DAZY_DB_URL=sqlite:///./dazy.db
# DAZY_DB_PATH=./dazy.db
#
# Uploaded gallery images. Needs persistent storage in production (Render disk / volume).
# DAZY_MEDIA_DIR=./media
#
# Local (non-Docker) dev only — Docker Compose sets VITE_API_BASE_URL via
# build args per frontend instead.
# VITE_API_BASE_URL=http://localhost:8000/api/v1
