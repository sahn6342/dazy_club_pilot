# Copy to .env and fill in real values before `docker compose up -d --build`.
# Never commit the real .env.

# Domains Caddy will request Let's Encrypt certs for — DNS A/AAAA records
# for each must already point at this server before starting Caddy.
WEB_DOMAIN=book.dazyclub.com
ADMIN_DOMAIN=admin.dazyclub.com
KIOSK_DOMAIN=pos.dazyclub.com
API_DOMAIN=api.dazyclub.com

# Runtime mode. Set to "production" for a live deploy: the API then refuses to boot
# with default JWT secret / admin creds or the noop payment provider. (Render sets
# this via render.yaml; leave empty for local dev and keyless trials.)
DAZY_ENV=
# Trusted reverse proxies in front of the API (compose: Caddy = 1). 0 = use socket peer.
# Rate limits use the Nth-from-right X-Forwarded-For entry, so clients cannot spoof their IP.
DAZY_PROXY_HOPS=1
# Cloudflare Turnstile secret key (bot check on booking / enquiry / OTP). Required when DAZY_ENV=production.
# Dev/test: leave empty to skip, or use Cloudflare's always-pass test secret 1x0000000000000000000000000000000AA.
# The matching PUBLIC site key goes in each web build as VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET=
# 1 = run without Turnstile (production would otherwise refuse to boot without the secret). Remove to enable.
# DAZY_TURNSTILE_DISABLED=1

# WhatsApp OTP through Meta's Cloud API. Default "whatsapp_stub" only prints codes (dev).
DAZY_NOTIFY_WHATSAPP_PROVIDER=whatsapp_stub
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_OTP_TEMPLATE=
# Approved utility templates for booking messages (text in docs/App-Overview.md 4.7). No template = skipped.
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=
WHATSAPP_TEMPLATE_BOOKING_CANCELLED=
WHATSAPP_TEMPLATE_BOOKING_REFUNDED=

# SMS through MSG91's Flow API (India: DLT templates). Default "sms_stub" only logs.
DAZY_NOTIFY_SMS_PROVIDER=sms_stub
MSG91_AUTH_KEY=
MSG91_TEMPLATE_BOOKING_PENDING=
MSG91_TEMPLATE_BOOKING_CONFIRMED=
MSG91_TEMPLATE_BOOKING_CANCELLED=
MSG91_TEMPLATE_BOOKING_REFUNDED=
MSG91_TEMPLATE_OTP=

# Staff session cookies (admin + kiosk). Defaults suit an API and SPAs under one registrable domain.
# DAZY_COOKIE_SAMESITE=lax        # lax | strict | none (none is for SPAs on a different site; forces Secure)
# DAZY_COOKIE_DOMAIN=.example.com # optional; unset = cookie bound to the API host only
# DAZY_COOKIE_SECURE=1            # default: on in production (or with SameSite=none), off for local http
# ADMIN_SESSION_EPOCH=0           # bump to sign out every env-admin session at once

# Observability (all optional). Logs are JSON lines in production, text locally (DAZY_LOG_FORMAT=json|text).
# SENTRY_DSN enables error reporting (no PII, no bodies, no locals; see apps/api/observability.py).
# SENTRY_DSN=
# SENTRY_ENV=production
# SENTRY_RELEASE=                  # defaults to Render's RENDER_GIT_COMMIT
# SENTRY_TRACES_SAMPLE_RATE=0
# DAZY_LOG_FORMAT=json
# DAZY_LOG_LEVEL=INFO

# Shared secret for POST /api/v1/internal/sweep (booking expiry + payment reconciliation cron).
# Leave empty to disable the endpoint.
# 1 = the phone/email booking search needs no one-time code (anyone with a contact sees its bookings). Remove to require OTP.
# DAZY_OTP_DISABLED=1
DAZY_INTERNAL_TOKEN=

# Auth — MUST be changed from defaults before going live.
JWT_SECRET=replace-with-a-random-32-plus-character-string
ADMIN_USERNAME=replace-with-a-real-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional, preferred: bcrypt hash of the admin password (replaces ADMIN_PASSWORD when set).
#   python -c "import bcrypt;print(bcrypt.hashpw(b'your-password',bcrypt.gensalt()).decode())"
# NOTE: in this file (read by docker compose) escape every "$" in the hash as "$$".
ADMIN_PASSWORD_HASH=

# Payment — set to razorpay + real keys for live checkout. With the default
# (noop) the booking flow still works, using dev "Simulate payment" buttons.
# Register the webhook in the Razorpay dashboard as
#   https://<API_DOMAIN>/api/v1/payments/razorpay/webhook
# (event: payment.captured) and paste its secret below.
DAZY_PAYMENT_PROVIDER=noop
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notifications — console (default) logs sends to `docker compose logs api`;
# set to email + SMTP creds to actually deliver booking confirmations.
DAZY_NOTIFY_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Render (production API) is configured in render.yaml. Every variable below that the
# API reads must also be listed there — keep both files in sync.
#
# Links / CORS. Compose sets these itself from the *_DOMAIN values above; set them
# explicitly on Render and for local overrides.
# DAZY_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# DAZY_WEB_BASE_URL=http://localhost:5173
# Printed in the booking-confirmation message:
# DAZY_VENUE_ADDRESS=R.K. Puram, Saguna more
# DAZY_VENUE_MAP_URL=https://maps.app.goo.gl/Ag1HGe5WjDDc68Tg8?g_st=ic
# DAZY_SUPPORT_PHONE=
#
# Database. Defaults to SQLite at DAZY_DB_PATH. Set DAZY_DB_URL to Postgres (Neon pooled
# URL ending in ?sslmode=require) with zero code changes; it overrides DAZY_DB_PATH.
# DAZY_DB_URL=sqlite:///./dazy.db
# DAZY_DB_PATH=./dazy.db
#
# Uploaded gallery images. "local" (default) writes to DAZY_MEDIA_DIR and is lost on redeploy
# unless a persistent disk is mounted; production uses Cloudflare R2 (S3 API, public bucket).
# DAZY_MEDIA_BACKEND=local
# DAZY_MEDIA_DIR=./media
# DAZY_MEDIA_LOCAL_OK=1          # production only: acknowledge local storage on a mounted disk
# DAZY_MEDIA_BACKEND=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://media.example.com
#
# Local (non-Docker) dev only — Docker Compose sets VITE_API_BASE_URL via
# build args per frontend instead.
# VITE_API_BASE_URL=http://localhost:8000/api/v1
