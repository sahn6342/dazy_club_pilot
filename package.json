{
  "name": "dazy-club-pilot",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @dazy/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "typecheck": "pnpm -r typecheck",
    "preview": "pnpm --filter @dazy/web preview",
    "api:dev": "dotnet run --project apps/api/Dazy.Api/Dazy.Api.csproj",
    "api:build": "dotnet build apps/api/Dazy.Api/Dazy.Api.csproj",
    "db:migrate": "echo \"EF Core migrations will be added after the API project is restored.\"",
    "seed": "echo \"Seed data is embedded in launch contracts for the pilot.\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.5.3"
}
