# Edge reverse proxy — auto-HTTPS via Let's Encrypt for each hostname.
# Set the four *_DOMAIN env vars in .env before `docker compose up`.

# Baseline security headers for the SPAs. The CSP is report-only: watch the console after deploying,
# then rename Content-Security-Policy-Report-Only to Content-Security-Policy to enforce.
(spa_security) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

{$WEB_DOMAIN} {
	import spa_security
	header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://checkout.razorpay.com; frame-src https://challenges.cloudflare.com https://api.razorpay.com https://checkout.razorpay.com; connect-src 'self' https://{$API_DOMAIN} https://api.razorpay.com https://lumberjack.razorpay.com https://checkout.razorpay.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'"
	reverse_proxy web:80
}

{$ADMIN_DOMAIN} {
	import spa_security
	header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; connect-src 'self' https://{$API_DOMAIN}; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; base-uri 'self'; form-action 'self'; frame-src 'none'; object-src 'none'; frame-ancestors 'none'"
	reverse_proxy admin:80
}

{$KIOSK_DOMAIN} {
	import spa_security
	header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; connect-src 'self' https://{$API_DOMAIN}; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; base-uri 'self'; form-action 'self'; frame-src 'none'; object-src 'none'; frame-ancestors 'none'"
	reverse_proxy kiosk:80
}

{$API_DOMAIN} {
	reverse_proxy api:8000
}
